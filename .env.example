# ---------------------------------------------------------------------------
# Paova — environment variables
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# App — must match the URL users open (and Supabase Auth Site URL / Redirect URLs)
# Production example: https://safe-sign-kappa.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase (Project Settings -> API). Use the EU region project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. HMAC secret for thank-you PDF download links.
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
# PDF_DOWNLOAD_SECRET=

# Number of reverse proxies / CDNs we control in front of the app. Determines
# which X-Forwarded-For entry is trustworthy for the proof dossier IP and the
# public rate limiter. 1 = one proxy (Vercel, Cloudflare…). 0 = app directly
# exposed, forwarding headers ignored entirely. Default: 1.
# TRUSTED_PROXY_HOPS=1

# Stripe (Developers -> API keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price id of the monthly subscription plan
STRIPE_PRICE_ID=

# Resend (transactional email). Emails are skipped when RESEND_API_KEY is empty.
RESEND_API_KEY=
# Sender. Free test sender works without a domain (delivers only to your own
# Resend account email). At launch, use your domain e.g. "Paova <noreply@paova.fr>".
RESEND_FROM=Paova <onboarding@resend.dev>
